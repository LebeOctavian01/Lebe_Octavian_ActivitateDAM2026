<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Hello World!"
     />
    <EditText
        android:id="@+id/nume_ET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/introduceti_numele"
        android:inputType=""

        />
    <CheckBox
        android:id="@+id/eStudent_CB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/esti_student"
        />

    <Button
        android:id="@+id/btn_apasa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/apasa"
        android:onClick="culegeDate"
        />
    <Button
        android:id="@+id/btnAdaugaBloc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adauga bloc" />


    <TextView
        android:id="@+id/tvRezultat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="18sp"
        android:text="Aici vor aparea datele blocului" />


</LinearLayout>